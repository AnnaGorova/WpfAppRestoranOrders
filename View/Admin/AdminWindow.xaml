<Window x:Class="WpfAppRestoranOrder.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppRestoranOrder.Admin"
        mc:Ignorable="d"
        Title="Адмін-панель ресторану" Height="600" Width="900" Background="Gold">
    
    <Grid Margin="10">

        <TabControl>

            <!-- 🗃️ ВСІ ТАБЛИЦІ БАЗИ ДАНИХ -->
            <TabItem Header="🗃️ Всі таблиці">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Всі таблиці бази даних" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TabControl Background="PaleGoldenrod">
                            <!-- 📂 КАТЕГОРІЇ -->
                            <TabItem Header="📂 Категорії">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Таблиця Categories" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>

                                    <!-- Кнопки CRUD для категорій -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button x:Name="AddCategoryBtn" Content="➕ Додати категорію" Margin="5" Padding="10" Click="AddCategoryBtn_Click"/>
                                        <Button x:Name="EditCategoryBtn" Content="✏️ Редагувати" Margin="5" Padding="10" Click="EditCategoryBtn_Click"/>
                                        <Button x:Name="DeleteCategoryBtn" Content="🗑️ Видалити" Margin="5" Padding="10" Click="DeleteCategoryBtn_Click"/>
                                        <Button x:Name="RefreshCategoriesBtn" Content="🔄 Оновити" Margin="5" Padding="10" Click="RefreshCategoriesBtn_Click"/>
                                    </StackPanel>

                                    <DataGrid x:Name="AllCategoriesGrid" AutoGenerateColumns="False" 
                                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              SelectionMode="Single" SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                            <DataGridTemplateColumn Header="Зображення" Width="*" MinWidth="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding ImageUrl}" Width="150" Height="150" Stretch="Uniform"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Назва" Binding="{Binding Name}" FontSize="16" Width="*" MinWidth="200"/>
                                            <DataGridTextColumn Header="Шлях до зображення" Binding="{Binding ImageUrl}" Width="*" MinWidth="250"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>

                            <!-- 🍽️ МЕНЮ -->
                            <TabItem Header="🍽️ Меню">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Таблиця MenuItems" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>

                                    <!-- Кнопки CRUD для меню -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button x:Name="AddMenuItemBtn" Content="➕ Додати страву" Margin="5" Padding="10" Click="AddMenuItemBtn_Click"/>
                                        <Button x:Name="EditMenuItemBtn" Content="✏️ Редагувати" Margin="5" Padding="10" Click="EditMenuItemBtn_Click"/>
                                        <Button x:Name="DeleteMenuItemBtn" Content="🗑️ Видалити" Margin="5" Padding="10" Click="DeleteMenuItemBtn_Click"/>
                                        <Button x:Name="RefreshMenuBtn" Content="🔄 Оновити" Margin="5" Padding="10" Click="RefreshMenuBtn_Click"/>
                                    </StackPanel>

                                    <DataGrid x:Name="AllMenuGrid" AutoGenerateColumns="False" 
                                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              SelectionMode="Single" SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                            <DataGridTemplateColumn Header="Зображення" Width="*" MinWidth="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding ImageUrl}" Width="100" Height="100" Stretch="Uniform"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                                            <DataGridTextColumn Header="Опис" Binding="{Binding Description}" Width="*" MinWidth="200"/>
                                            <DataGridTextColumn Header="Ціна" Binding="{Binding Price, StringFormat={}{0} грн}" Width="*" MinWidth="70"/>
                                            <DataGridTextColumn Header="Категорія" Binding="{Binding Category}" Width="*" MinWidth="100"/>
                                            <DataGridCheckBoxColumn Header="Доступно" Binding="{Binding IsAvailable}" Width="*" MinWidth="70" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>

                            <!-- 📋 ЗАМОВЛЕННЯ -->
                            <TabItem Header="📋 Замовлення">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Таблиця Orders" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>

                                    <!-- Кнопки CRUD для замовлень -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                        <Button x:Name="EditOrderBtn" Content="✏️ Редагувати Status" Margin="5" Padding="10" Click="EditOrderBtn_Click"/>
                                        <Button x:Name="EditOrderContactBtn" Content="Редагувати контакти" Margin="5" Padding="10" Click="EditOrderContactBtn_Click"/>
                                        <Button x:Name="DeleteOrderBtn" Content="🗑️ Видалити" Margin="5" Padding="10" Click="DeleteOrderBtn_Click"/>
                                        <Button x:Name="RefreshOrdersBtn" Content="🔄 Оновити" Margin="5" Padding="10" Click="RefreshOrdersBtn_Click"/>
                                    </StackPanel>

                                    <DataGrid x:Name="AllOrdersGrid" AutoGenerateColumns="False" 
                                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              SelectionMode="Single" SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                           
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yy HH:mm}}" Width="*" MinWidth="100"/>
                                            <DataGridTextColumn Header="Клієнт" Binding="{Binding CustomerName}" Width="*" MinWidth="120"/>
                                            <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="*" MinWidth="100"/>
                                            <DataGridTextColumn Header="Сума" Binding="{Binding TotalAmount, StringFormat={}{0} грн}" Width="*" MinWidth="70"/>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" MinWidth="80"/>
                                            <DataGridTextColumn Header="Адреса" Binding="{Binding DeliveryAddress}" Width="*" MinWidth="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>

                            <!-- 🛒 ПОЗИЦІЇ ЗАМОВЛЕНЬ -->
                            <TabItem Header="🛒 Позиції замовлень">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Таблиця OrderItems" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <Button x:Name="RefreshOrderItemsBtn" Content="🔄 Оновити" Margin="5" Padding="10" Click="RefreshOrderItemsBtn_Click"/>

                                    <DataGrid x:Name="AllOrderItemsGrid" AutoGenerateColumns="False" 
                                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              SelectionMode="Single" SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                            <DataGridTextColumn Header="ID замовлення" Binding="{Binding OrderId}" Width="*" MinWidth="80"/>
                                            <DataGridTextColumn Header="ID страви" Binding="{Binding MenuItemId}" Width="*" MinWidth="70"/>
                                            <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}" Width="*" MinWidth="70"/>
                                            <DataGridTextColumn Header="Ціна" Binding="{Binding UnitPrice, StringFormat={}{0} грн}" Width="*" MinWidth="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>

                            <!-- 📊 СТАТИСТИКА ТАБЛИЦЬ -->
                            <TabItem Header="📊 Статистика таблиць">
                                <StackPanel Margin="5">
                                    <TextBlock Text="Статистика таблиць" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <WrapPanel>
                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" Background="#FFF0F8FF">
                                            <StackPanel>
                                                <TextBlock Text="Категорії" FontWeight="Bold"/>
                                                <TextBlock x:Name="CategoriesCount" Text="0" FontSize="14" Foreground="Blue"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" Background="#FFF0FFF0">
                                            <StackPanel>
                                                <TextBlock Text="Страви" FontWeight="Bold"/>
                                                <TextBlock x:Name="MenuItemsCount" Text="0" FontSize="14" Foreground="Green"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" Background="#FFFFF0F5">
                                            <StackPanel>
                                                <TextBlock Text="Замовлення" FontWeight="Bold"/>
                                                <TextBlock x:Name="OrdersCount" Text="0" FontSize="14" Foreground="Orange"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" Background="#FFFFF8DC">
                                            <StackPanel>
                                                <TextBlock Text="Позиції" FontWeight="Bold"/>
                                                <TextBlock x:Name="OrderItemsCount" Text="0" FontSize="14" Foreground="Purple"/>
                                            </StackPanel>
                                        </Border>



                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" Background="#FFFFFACD">
                                            <StackPanel>
                                                <TextBlock Text="Загальний дохід" FontWeight="Bold"/>
                                                <TextBlock x:Name="TotalRevenueText" Text="0 ₴" FontSize="14" Foreground="DarkRed" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" Background="#FFE6E6FA">
                                            <StackPanel>
                                                <TextBlock Text="Завершені замовлення" FontWeight="Bold"/>
                                                <TextBlock x:Name="CompletedOrdersCount" Text="0" FontSize="14" Foreground="DarkBlue"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" Background="#FFD3FFD3">
                                            <StackPanel>
                                                <TextBlock Text="Скасовані замовлення" FontWeight="Bold"/>
                                                <TextBlock x:Name="CancelledOrdersCount" Text="0" FontSize="14" Foreground="DarkGray"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="15" Background="#FFF5F5F5">
                                            <StackPanel>
                                                <TextBlock Text="📈 Детальна статистика" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="DetailedStatsText" TextWrapping="Wrap" FontSize="12" Text="Завантаження..."/>
                                            </StackPanel>
                                        </Border>


                                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" Background="#FFFFF0F5">
                                            <StackPanel>
                                                <TextBlock Text="🏆 Топ-5 найпопулярніших страв" FontWeight="Bold" Margin="0,0,0,5"/>
                                                <ItemsControl x:Name="TopDishesItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#FFF8F8F8" Margin="0,2" Padding="8,5" CornerRadius="3">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0" Text="{Binding Position}" 
                                                                          FontWeight="Bold" Foreground="#FF8B0000" 
                                                                          VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                                                          VerticalAlignment="Center" Margin="5,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding OrderCount}" 
                                                                            Foreground="Green" FontWeight="Bold" 
                                                                            Margin="10,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="замовлень" 
                                                                          FontSize="10" Foreground="Gray" 
                                                                          VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                    </WrapPanel>

                                    <Button x:Name="RefreshAllDataBtn" Content="🔄 Оновити всі дані" 
                                            Click="RefreshAllDataBtn_Click" Margin="0,10,0,0" 
                                            Padding="10" Width="200" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </TabItem>



                        </TabControl>



                        <GroupBox Header="💬 Чат з кухнею" Margin="10">
                            <StackPanel>
                                <TextBox x:Name="ChatBox" Height="80" IsReadOnly="True" 
                                    Background="#FFF0F0F0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                               
                                <TextBox x:Name="MessageTextBox" Height="60" Margin="0,5,0,5"
                                         Background="White" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="Введіть повідомлення для кухні..."
                                         FontSize="14" Padding="5"/>

                                <Button Content="📢 Надіслати кухні" Click="SendToKitchenBtn_Click"
                                        Margin="0,5" Padding="10,5" Background="#FF8B0000" Foreground="White"/>
                            </StackPanel>
                        </GroupBox>
                        

                    </StackPanel>
                </ScrollViewer>
                
                
                
            </TabItem>



           

        </TabControl>



        


    </Grid>
</Window>