<Window x:Class="WpfAppRestoranOrder.View.Client.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ресторан Швидкого Замовлення - Клієнт" Height="820" Width="940"
          WindowStartupLocation="Manual"
        Left="0"
        Top="0"
        Background="#FF272727">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🟥 ШАПКА -->
        <Border Grid.Row="0" Background="#FFBC1D1D" Height="80">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🍔" FontSize="40" 
                          VerticalAlignment="Center" Margin="20,0"/>

                <TextBlock Grid.Column="1" Text="Ресторан Швидкого Замовлення" 
                          FontSize="28" FontWeight="Bold" 
                          Foreground="Yellow" VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="🛒" FontSize="24" Margin="0,0,5,0"/>
                    <TextBlock x:Name="CartCountText" Text="0" FontSize="20" 
                              Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="₴" FontSize="20" Foreground="White" 
                              Margin="10,0,0,0" FontWeight="Bold"/>
                    <TextBlock x:Name="CartTotalHeaderText" Text="0" FontSize="20" 
                              Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 📱 ОСНОВНИЙ КОНТЕНТ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- КАТЕГОРІЇ -->
            <Border Grid.Column="0" Background="#FF3C3C3C" BorderThickness="0,0,1,0" BorderBrush="#FF555555">
                <StackPanel>
                    <TextBlock Text="📂 Категорії" FontSize="18" FontWeight="Bold" 
                  Foreground="White" Margin="15,20,15,10"/>

                  
                    <Button x:Name="AllDishesButton" 
                Content="🍽️ Всі страви" 
                Click="AllDishesButton_Click"
                Margin="10,0,10,10" 
                Padding="10,8" 
                Background="#FFBC1D1D" 
                Foreground="White"
                FontWeight="Bold"
                FontSize="14"/>

                    <ListBox x:Name="CategoriesListBox" Background="Transparent" 
                BorderThickness="0" Foreground="White"
                FontSize="14" SelectionChanged="CategoriesListBox_SelectionChanged">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="10,8" 
                              FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            
            
            
            <!-- МЕНЮ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MenuItemsControl" Margin="10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="285" Background="#FF404040" 
                                   Margin="10" CornerRadius="10"
                                   BorderBrush="#FF555555" BorderThickness="1">
                                <StackPanel>
                                    <Image Source="{Binding ImageUrl}" Height="120" 
                                          Stretch="UniformToFill" Margin="10,10,10,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="16" 
                                              FontWeight="Bold" Foreground="White" 
                                              Margin="10,5" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" 
                                              Foreground="#CCCCCC" Margin="10,0" 
                                              TextWrapping="Wrap" Height="40"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}₴{0}}" 
                                              FontSize="18" FontWeight="Bold" 
                                              Foreground="Yellow" Margin="10,5"/>
                                    <Button Content="➕ Додати до кошика" 
                                            Background="#FFBC1D1D" Foreground="White"
                                            FontWeight="Bold" Margin="10" Padding="10,5"
                                            Click="AddToCartButton_Click"
                                            Tag="{Binding Id}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 🛒 КОШИК -->
        <Border Grid.Row="2" Background="#FF2C2C2C" BorderThickness="0,1,0,0" BorderBrush="#FF555555">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <ItemsControl x:Name="CartItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF404040" Margin="0,2" Padding="10" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                                  Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <Button Grid.Column="1" Content="➖" 
                                                Background="#FF666666" Foreground="White" FontWeight="Bold"
                                                Width="30" Height="30" Margin="10,0,5,0"
                                                Click="DecreaseQuantityButton_Click"
                                                Tag="{Binding MenuItemId}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Quantity}" 
                                                  Foreground="Yellow" Margin="5,0" FontSize="16"
                                                  VerticalAlignment="Center" FontWeight="Bold"
                                                  Width="30" TextAlignment="Center"/>
                                        <Button Grid.Column="3" Content="➕" 
                                                Background="#FF666666" Foreground="White" FontWeight="Bold"
                                                Width="30" Height="30" Margin="5,0,10,0"
                                                Click="IncreaseQuantityButton_Click"
                                                Tag="{Binding MenuItemId}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Price, StringFormat={}₴{0}}" 
                                                  Foreground="#CCCCCC" Margin="10,0" 
                                                  VerticalAlignment="Center" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="{Binding TotalPrice, StringFormat={}₴{0}}" 
                                                  Foreground="Yellow" Margin="10,0" 
                                                  VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Загальна сума:" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock x:Name="CartTotalAmountText" Text="0" Foreground="Yellow" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="₴" Foreground="Yellow" FontSize="18" FontWeight="Bold" Margin="5,0,0,0"/>
                </StackPanel>

                <Button Grid.Row="1" Grid.Column="1" Content="🚀 ЗАМОВИТИ" 
                        Background="#FFBC1D1D" Foreground="White"
                        FontSize="16" FontWeight="Bold" Padding="20,10"
                        Click="PlaceOrderButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>