<Window x:Class="WpfAppRestoranOrder.View.Kitchen.KitchenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ресторан - Кухня" Height="820" Width="620"
        WindowStartupLocation="Manual" 
        Left="940"
        Top="0"
        Background="#FF1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- Фільтри -->
            <RowDefinition Height="*"/>
            <!-- Замовлення -->
            <RowDefinition Height="Auto"/>
            <!-- Статистика -->
        </Grid.RowDefinitions>

        <!-- 🟥 ШАПКА КУХНІ -->
        <Border Grid.Row="0" Background="#FF8B0000" Height="70">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="👨‍🍳" FontSize="36" 
                          VerticalAlignment="Center" Margin="20,0"/>

                <TextBlock Grid.Column="1" Text="КУХНЯ - Панель замовлень" 
                          FontSize="24" FontWeight="Bold" 
                          Foreground="White" VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="🔄" FontSize="20" Margin="0,0,5,0"/>
                    <Button x:Name="RefreshBtn" Content="Оновити" 
                            Background="#FFA52A2A" Foreground="White"
                            FontWeight="Bold" Padding="10,5"
                            Click="RefreshBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 🔧 ПАНЕЛЬ ФІЛЬТРІВ ТА СТАТУСІВ -->
        <Border Grid.Row="1" Background="#FF2C2C2C" Padding="10" BorderThickness="0,0,0,1" BorderBrush="#FF555555">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Фільтр за статусом:" 
                          Foreground="White" FontWeight="Bold" 
                          VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox x:Name="StatusFilterComboBox" Width="150" Height="30"
                         SelectionChanged="StatusFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Всі активні" IsSelected="True"/>
                    <ComboBoxItem Content="Нові"/>
                    <ComboBoxItem Content="В роботі"/>
                    <ComboBoxItem Content="Готові"/>
                    <ComboBoxItem Content="Історія замовлень"/>
                </ComboBox>

                <TextBlock Text="Статистика:" 
                          Foreground="White" FontWeight="Bold" 
                          VerticalAlignment="Center" Margin="20,0,10,0"/>

                <Border Background="#FF8B0000" CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                    <TextBlock x:Name="NewOrdersCount" Text="0" 
                              Foreground="White" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="Нові" Foreground="#CCCCCC" Margin="0,0,15,0"/>

                <Border Background="#FFFF8C00" CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                    <TextBlock x:Name="InProgressCount" Text="0" 
                              Foreground="White" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="В роботі" Foreground="#CCCCCC" Margin="0,0,15,0"/>

                <Border Background="#FF32CD32" CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                    <TextBlock x:Name="ReadyCount" Text="0" 
                              Foreground="White" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="Готові" Foreground="#CCCCCC"/>
            </StackPanel>
        </Border>

        <!-- 📋 СПИСОК ЗАМОВЛЕНЬ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersItemsControl" Margin="10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- КАРТКА ЗАМОВЛЕННЯ -->
                        <Border Background="#FF404040" Margin="10" CornerRadius="8"
                               BorderThickness="2" BorderBrush="{Binding StatusColor}">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Заголовок замовлення -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📦 Замовлення №" 
                                              Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Id}" 
                                              Foreground="Yellow" FontWeight="Bold" Margin="5,0,0,0"/>
                                    <TextBlock Text="•" Foreground="#666666" Margin="10,0,10,0"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat={}dd.MM.yyyy HH:mm}" 
                                              Foreground="#CCCCCC"/>
                                </StackPanel>

                                <!-- Статус -->
                                <Border Grid.Row="0" Grid.Column="1" 
                                       Background="{Binding StatusColor}" CornerRadius="3" Padding="8,3">
                                    <TextBlock Text="{Binding StatusDisplay}" 
                                              Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>

                                <!-- Дані клієнта -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,5">
                                    <TextBlock Text="{Binding CustomerName}" 
                                              Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding PhoneNumber}" 
                                              Foreground="#CCCCCC" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding DeliveryAddress}" 
                                              Foreground="#AAAAAA" Margin="0,2,0,0"
                                              Visibility="{Binding DeliveryAddressVisibility}"/>
                                </StackPanel>

                                <!-- Список страв -->
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                       Background="#FF333333" CornerRadius="5" Padding="10" Margin="0,5,0,10">
                                    <ItemsControl x:Name="OrderItemsList" ItemsSource="{Binding OrderItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FF555555" Margin="0,2" Padding="8,5" CornerRadius="3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                                                  Foreground="White" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" 
                                                                  Foreground="Yellow" Margin="10,0" FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="2" Text="x" Foreground="#CCCCCC"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Сума -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                          Text="{Binding TotalAmount, StringFormat={}Загальна сума: {0}₴}" 
                                          Foreground="Yellow" FontWeight="Bold" FontSize="14"
                                          HorizontalAlignment="Right" Margin="0,0,0,10"/>

                                <!-- КНОПКИ ЗМІНИ СТАТУСУ -->
                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                                         Orientation="Horizontal" HorizontalAlignment="Right">

                                    <Button Content="✅ Прийняти" 
                                        Background="#FF32CD32" Foreground="White" FontWeight="Bold"
                                        Padding="15,8" Margin="5,0"
                                        Click="AcceptOrderBtn_Click"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding AcceptButtonVisibility}"/>

                                    <Button Content="👨‍🍳 Готується" 
                                        Background="#FFFF8C00" Foreground="White" FontWeight="Bold"
                                        Padding="15,8" Margin="5,0"
                                        Click="StartCookingBtn_Click"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding CookingButtonVisibility}"/>

                                    <Button Content="🍽️ Готове" 
                                        Background="#FF008000" Foreground="White" FontWeight="Bold"
                                        Padding="15,8" Margin="5,0"
                                        Click="ReadyOrderBtn_Click"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding ReadyButtonVisibility}"/>


                                    <Button Content="📤 Видано" 
                                        Background="#FF006400" Foreground="White" FontWeight="Bold"
                                        Padding="15,8" Margin="5,0"
                                        Click="CompleteOrderBtn_Click"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding CompleteButtonVisibility}"/>

                                    <Button Content="❌ Скасувати" 
                                        Background="#FF8B0000" Foreground="White" FontWeight="Bold"
                                        Padding="15,8" Margin="5,0"
                                        Click="CancelOrderBtn_Click"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding CancelButtonVisibility}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>




        <!-- 📊 СТАТИСТИКА -->
        <Border Grid.Row="3" Background="#FF2C2C2C" Padding="10" BorderThickness="1,0,0,0" BorderBrush="#FF555555">
            <StackPanel>
                <!-- Статистика зверху -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="🕒 Активних замовлень:" 
                      Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ActiveOrdersText" Text="0" 
                      Foreground="Yellow" FontWeight="Bold" FontSize="16"/>
                </StackPanel>

                <!-- Чат знизу -->
                <Border Background="#FF3A3A3A" CornerRadius="5" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" x:Name="ChatBox" Height="60" IsReadOnly="True" 
                            Background="#FF505050" Foreground="White" TextWrapping="Wrap"
                            BorderThickness="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- ✅ TEXTBOX ДЛЯ ВВОДУ -->
                            <TextBox Grid.Column="0" x:Name="MessageTextBox" Height="30"
                                Background="White" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                Text="Повідомлення адміну..." FontSize="11" Padding="5"
                                Margin="0,0,5,0"/>

                            <Button Grid.Column="1" Content="📢 Надіслати" Click="SendToAdminBtn_Click"
                                Padding="15,5" Background="#FF8B0000" Foreground="White" FontWeight="Bold"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>


    </Grid>
</Window>
