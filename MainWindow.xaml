<Window x:Class="WpfAppRestoranOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ресторан - Головне вікно" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"  Background="Black"  Foreground="White">


    
    
    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="https://images.unsplash.com/photo-1513104890138-7c749659a591?
                        ixlib=rb-4.0.3&amp;ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&amp;
                        auto=format&amp;fit=crop&amp;w=2070&amp;q=80"
                       Stretch="UniformToFill"  />
        </Grid.Background>

       
        <Rectangle Fill="Black" Opacity="0.3"/>


        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="🚀 Ресторан 'Швидке замовлення'" 
                       FontSize="46" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="White"/>
            <TextBlock Text="Всі вікна відкриті!" 
                       FontSize="28" Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Закрийте це вікно для виходу з програми" 
                       FontSize="20" Foreground="White" FontStyle="Italic"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>